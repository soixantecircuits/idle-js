{
  "name": "idle-js",
  "version": "2.0.0",
  "description": "Detect user idleness. In other words, play with activity state.",
  "keywords": [
    "activity",
    "events",
    "idle",
    "interactivity",
    "timeout",
    "user state"
  ],
  "bugs": {
    "url": "https://github.com/soixantecircuits/idle-js/issues"
  },
  "license": "MIT",
  "author": "hugohil <hilairehugo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/soixantecircuits/idle-js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
